 "mechanism_list_sha256": "9de62ef055007fe75c983dc8754c0bc1b98bab5842a9028293cfb015ac65e370",
 "mechanism_hash_spec": "sha256 over newline-terminated lines 'det:obs:p_num/p_den' in canonical order (ascending by (det, obs)), UTF-8",
 "decoder_spec": "Lookup-table (coset-leader) decoder. Depth-truncated FIFO BFS over the syndrome space {0,1}^n_det from syndrome 0 (weight 0, predicted observable 0), expanding a node only while its depth < WMAX, mechanisms applied in canonical index order; first assignment wins. Decoder output D(s) = pred[s], the observable flip of the first-found minimum-weight fault set consistent with s. A fault set F is correctable iff D(sigma(F)) == obs(F). For every syndrome reachable by a weight-<=WMAX fault set this pred[] equals the full-BFS coset leader table (whose 2^n_det entries are not embedded at d>=5). Cf. Tomita & Svore, Phys. Rev. A 90, 062320 (2014).",
 "WMAX": 5,
 "circuit_level_distance": 5,
